{
  "scss.lint.unknownAtRules": "ignore",
  "exportall.config.folderListener": [
    "/src/app/interfaces",
    "/src/app/helpers"
  ],
  "files.exclude": {
    "dist\\reformkingdom": true,
    "dist": true
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.format.enable": true,
  "eslint.lintTask.enable": true,
  "eslint.validate": ["typescript", "javascript"],
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "yaml.schemas": {
    "./schemas/collectible.schema.json": "gamedata/collectible/*.yml",
    "./schemas/equipment.schema.json": "gamedata/equipment/*.yml",
    "./schemas/item.schema.json": "gamedata/item/*.yml",
    "./schemas/job.schema.json": "gamedata/job/*.yml",
    "./schemas/monster.schema.json": "gamedata/monster/*.yml",
    "./schemas/skill.schema.json": "gamedata/skill/*.yml",
    "./schemas/trait.schema.json": "gamedata/trait/*.yml"
  }
}
