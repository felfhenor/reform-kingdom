{
  "name": "reformkingdom",
  "version": "0.5.3",
  "scripts": {
    "start": "concurrently \"npm run start:app\" \"npm run gamedata:watch\"",
    "start:app": "ng serve --open --port 9766",
    "setup": "npm run gamedata:build",
    "lint": "ng lint",
    "test": "vitest run",
    "test:watch": "vitest --ui --api 9899",
    "build:copychangelog": "cpy CHANGELOG.md CHANGELOG-current.md dist/reformkingdom/browser",
    "build:syncversion": "ts-node --project tsconfig.scripts.json scripts/build-syncversion",
    "build:versioninfo": "ts-node --project tsconfig.scripts.json scripts/build-versioninfo",
    "build:blogpost": "ts-node --project tsconfig.scripts.json scripts/build-blogpost",
    "build:maps": "ts-node --project tsconfig.scripts.json scripts/build-maps",
    "build:electron": "npm run build && npm run build:syncversion && npm run build:electron:package",
    "build:electron:package": "cd electron && npm run make",
    "build": "npm run build:versioninfo && npm run gamedata:build && npm run gamedata:art:spritesheets && npm run build:maps && ng build --configuration production && npm run build:copychangelog",
    "gamedata:watch": "ts-node --project tsconfig.scripts.json scripts/gamedata-watch",
    "gamedata:build": "ts-node --project tsconfig.scripts.json scripts/gamedata-build",
    "gamedata:art:spritesheets": "ts-node --project tsconfig.scripts.json scripts/gamedata-art-spritesheets",
    "schemas:generate": "npx ts-node --project tsconfig.scripts.json scripts/schema-generate",
    "validate": "concurrently --prefix none \"npm run validate:fieldnodes\" \"npm run validate:teleportnodes\" \"npm run validate:nodenames\" \"npm run validate:completionrewards\" \"npm run validate:reciperewards\" \"npm run validate:recipenames\" \"npm run validate:schemas\" \"npm run validate:obtainability\" \"npm run validate:tradeskillxpgaps\" \"npm run validate:recipeingredientorder\" \"npm run validate:sprites\" \"npm run validate:unusedsprites\" \"npm run validate:commissionusage\"",
    "validate:fieldnodes": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-fieldnodes",
    "validate:teleportnodes": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-teleportnodes",
    "validate:nodenames": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-nodenames",
    "validate:completionrewards": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-completionrewards",
    "validate:reciperewards": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-reciperewards",
    "validate:recipenames": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-recipenames",
    "validate:schemas": "ts-node --project tsconfig.scripts.json scripts/validate-schemas",
    "validate:obtainability": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-obtainability",
    "validate:tradeskillxpgaps": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-tradeskillxpgaps",
    "validate:recipeingredientorder": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-recipeingredientorder",
    "validate:sprites": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-sprites",
    "validate:unusedsprites": "ts-node --project tsconfig.scripts.json scripts/validate-unusedsprites",
    "validate:commissionusage": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/validate-commissionusage",
    "bump:major": "npm version major -m \"chore(release): Major %s\"",
    "bump:minor": "npm version minor -m \"chore(release): Minor %s\"",
    "bump:patch": "npm version patch -m \"chore(release): Patch %s\"",
    "analyze:herostats": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/analyze-herostats",
    "analyze:monsterstats": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/analyze-monsterstats",
    "analyze:materialutilization": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/analyze-materialutilization",
    "analyze:contentgaps": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/analyze-contentgaps",
    "analyze:nodelevels": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/analyze-nodelevels",
    "analyze:debuffresistance": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/analyze-debuffresistance",
    "analyze:workerstamina": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/analyze-workerstamina",
    "analyze:workerreachability": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/analyze-workerreachability",
    "util:changelog:generate": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "util:changelog:generate:current": "conventional-changelog -p angular -o CHANGELOG-current.md -r 2",
    "util:changelog:commit": "git commit CHANGELOG.md CHANGELOG-current.md -m \"Update changelog\" || true",
    "util:dirtycheck": "ts-node --project tsconfig.scripts.json scripts/util-dirtycheck",
    "util:version:reversion": "ts-node --project tsconfig.scripts.json scripts/util-postversion-reversion",
    "simulate": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/simulate/run",
    "preversion": "npm run util:dirtycheck && npm run lint && npm run test && npm run build",
    "postversion": "npm run util:changelog:generate && npm run util:changelog:generate:current && npm run util:changelog:commit && npm run util:version:reversion && npm run push",
    "push": "git push && git push --tags",
    "postinstall": "npm run gamedata:build && npm run gamedata:art:spritesheets && npm run schemas:generate"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@boringnode/pluralize": "^0.1.0",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/game-icons": "^34.0.0",
    "@ng-icons/tabler-icons": "^34.0.0",
    "@ng-select/ng-select": "^23.5.1",
    "@ngneat/helipopper": "^13.1.2",
    "@ngneat/hotkeys": "^4.1.0",
    "@sweetalert2/ngx-sweetalert2": "^15.0.0",
    "@taiga-ui/event-plugins": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "console-log-colors": "^0.5.0",
    "es-toolkit": "^1.50.0",
    "gameanalytics": "^4.4.7",
    "jimp": "^1.6.1",
    "logger-timer": "^1.0.7",
    "marked": "^18.0.7",
    "mustache": "^4.2.0",
    "ngx-drag-drop": "^22.0.0",
    "ngx-timeago": "^4.1.0",
    "ngx-toastr": "^20.0.5",
    "ngxtension": "^7.2.0",
    "pixi.js": "^8.19.0",
    "rollbar": "^3.1.0",
    "rxjs": "^7.8.2",
    "seedrandom": "^3.0.5",
    "spritesmith": "^3.5.1",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.8.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.39.5",
    "@types/fs-extra": "^11.0.4",
    "@types/howler": "^2.2.13",
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.2",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "ajv": "^8.20.0",
    "angular-eslint": "^22.1.0",
    "autoprefixer": "^10.5.4",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.4",
    "conventional-changelog": "^6.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "cpy-cli": "^7.0.0",
    "daisyui": "^5.7.9",
    "eslint": "^9.39.5",
    "eslint-plugin-typescript-paths": "^0.0.33",
    "fs-extra": "^11.4.0",
    "git-describe": "^4.1.1",
    "imagemin": "^7.0.1",
    "imagemin-webp": "^6.1.0",
    "js-yaml": "^5.2.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "recursive-readdir": "^2.2.3",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.15.0",
    "typescript": "6.0",
    "typescript-eslint": "^8.62.1",
    "typescript-json-schema": "^0.65.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-tsconfig-paths": "^3.4.1"
  },
  "overrides": {
    "@sweetalert2/ngx-sweetalert2": {
      "@angular/common": "22",
      "@angular/core": "22"
    },
    "ngx-toastr": {
      "@angular/common": "22",
      "@angular/core": "22"
    }
  }
}
